# ==============================================================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# Copy to `.env` in this directory to customize local Docker deployment.
# ==============================================================================

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_management_db
POSTGRES_PORT=5432

# Backend Settings
BACKEND_PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000
COOKIE_DOMAIN=localhost

# JWT Secrets (Minimum 16 characters each)
JWT_ACCESS_SECRET=school_management_super_secret_jwt_access_key_2026_secure
JWT_REFRESH_SECRET=school_management_super_secret_jwt_refresh_key_2026_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Platform Super Admin Seed Credentials
SUPER_ADMIN_EMAIL=superadmin@platform.com
SUPER_ADMIN_PASSWORD=SuperAdmin@Secure123!
SUPER_ADMIN_NAME=Platform Super Admin

# Frontend Settings
FRONTEND_PORT=80
VITE_API_BASE_URL=/api/v1
