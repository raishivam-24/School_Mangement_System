# ==============================================================================
# SERVER & APP CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ==============================================================================
# DATABASE (PostgreSQL - Local / Neon / Supabase / AWS RDS)
# Example: postgresql://postgres:password@localhost:5432/school_management_db?schema=public
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_management_db?schema=public"

# ==============================================================================
# AUTHENTICATION & JWT (HttpOnly Cookies & Bearer Tokens)
# ==============================================================================
JWT_ACCESS_SECRET=school_management_super_secret_jwt_access_key_2026_secure
JWT_REFRESH_SECRET=school_management_super_secret_jwt_refresh_key_2026_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost

# ==============================================================================
# 🗄️ FILE & OBJECT STORAGE (AWS S3 / Cloudflare R2 / MinIO / Local Disk)
# - Set STORAGE_DRIVER=local for instant development (stores in uploads/)
# - Set STORAGE_DRIVER=s3 for production cloud storage
# ==============================================================================
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Required if STORAGE_DRIVER=s3 (AWS S3, MinIO, or Cloudflare R2)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-school-management-bucket
# Optional: Set endpoint for Cloudflare R2 or MinIO (leave empty for AWS S3)
# AWS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ==============================================================================
# ⚡ REDIS (Caching, BullMQ Background Queues, Rate Limiting)
# Supports Upstash, Redis Cloud, AWS ElastiCache, or local Docker Redis
# ==============================================================================
# Full connection string (e.g. from Upstash or Redis Cloud):
REDIS_URL="redis://default:your_redis_password@your-redis-host.upstash.io:6379"

# Or individual host/port (e.g. for local Docker):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# ✉️ EMAIL & NOTIFICATIONS (Optional: Resend / SendGrid / SMTP)
# ==============================================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM="SchoolHub <notifications@schoolhub.edu>"

# ==============================================================================
# PLATFORM SUPER ADMIN SEED CREDENTIALS
# ==============================================================================
SUPER_ADMIN_EMAIL=superadmin@platform.com
SUPER_ADMIN_PASSWORD=SuperAdmin@Secure123!
SUPER_ADMIN_NAME="Platform Super Admin"
