// ==============================================================================
// Prisma Schema — Multi-Tenant School Management SaaS
// ==============================================================================
// Database Architecture: Shared Database + Shared Schema with explicit `schoolId`
// isolation on all tenant-owned models.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum UserRole {
  SUPER_ADMIN   // Platform level administrator
  SCHOOL_ADMIN  // School tenant administrator
  TEACHER       // Teacher staff
  STUDENT       // Student
  PARENT        // Parent/Guardian
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  VOID
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  EXCUSED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ExamStatus {
  UPCOMING
  ONGOING
  COMPLETED
  PUBLISHED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

enum AudienceType {
  ALL
  TEACHERS
  STUDENTS
  PARENTS
  CLASS
}

// ==============================================================================
// PLATFORM & MULTI-TENANCY MODELS
// ==============================================================================

/// Represents a distinct School Tenant in the SaaS system
model School {
  id              String       @id @default(uuid())
  name            String
  code            String       @unique // e.g. "DPS-DELHI", url-friendly slug or code
  email           String
  phone           String?
  address         String?
  website         String?
  logoUrl         String?
  status          SchoolStatus @default(TRIAL)
  maxStudents     Int          @default(1000)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Tenant Relationships
  users           User[]
  subscriptions   SchoolSubscription[]
  platformInvoices PlatformInvoice[]
  academicYears   AcademicYear[]
  classes         Class[]
  sections        Section[]
  subjects        Subject[]
  classSubjects   ClassSubject[]
  teachers        Teacher[]
  students        Student[]
  parents         Parent[]
  enrollments     Enrollment[]
  attendances     Attendance[]
  timetables      Timetable[]
  assignments     Assignment[]
  exams           Exam[]
  feeStructures   FeeStructure[]
  feeInvoices     FeeInvoice[]
  feePayments     FeePayment[]
  announcements   Announcement[]
  documents       Document[]
  auditLogs       AuditLog[]

  @@index([status])
  @@index([code])
}

/// School SaaS Subscription managed by Super Admin
model SchoolSubscription {
  id              String             @id @default(uuid())
  schoolId        String
  plan            SubscriptionPlan   @default(BASIC)
  status          SubscriptionStatus @default(TRIALING)
  amount          Decimal            @default(0.0) @db.Decimal(10, 2)
  billingCycle    String             @default("MONTHLY") // MONTHLY | ANNUALLY
  startDate       DateTime           @default(now())
  endDate         DateTime
  nextBillingDate DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
}

/// SaaS Platform Invoices for Schools (Billing School for SaaS usage)
model PlatformInvoice {
  id            String        @id @default(uuid())
  schoolId      String
  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
}

// ==============================================================================
// AUTHENTICATION, USERS & AUDITING
// ==============================================================================

/// Application User model across Super Admins and School Users
model User {
  id            String      @id @default(uuid())
  schoolId      String?     // NULL for Super Admin; Required for School Users
  email         String      @unique
  passwordHash  String
  name          String
  role          UserRole    @default(STUDENT)
  status        UserStatus  @default(ACTIVE)
  avatarUrl     String?
  phone         String?
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Tenant link (nullable for platform super admin)
  school        School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Sub-profile relations
  teacherProfile Teacher?
  studentProfile Student?
  parentProfile  Parent?

  // Operational references
  refreshTokens  RefreshToken[]
  createdAnnouncements Announcement[]
  sentNotifications    Notification[]
  auditLogs            AuditLog[]

  @@index([schoolId])
  @@index([email])
  @@index([role])
}

/// Refresh tokens for secure rotating authentication sessions
model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

/// System Audit Trail for administrative actions
model AuditLog {
  id          String   @id @default(uuid())
  schoolId    String?  // Nullable if Super Admin action
  userId      String?  // The user who performed the action
  action      String   // e.g. "USER_LOGIN", "STUDENT_CREATED", "FEE_COLLECTED"
  entity      String   // e.g. "Student", "FeeInvoice"
  entityId    String?
  details     Json?    // Context payload / diffs
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ==============================================================================
// ACADEMIC STRUCTURE
// ==============================================================================

/// Academic Year (e.g., 2025-26) to preserve academic history
model AcademicYear {
  id          String       @id @default(uuid())
  schoolId    String
  name        String       // e.g. "2025-2026"
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  attendances Attendance[]
  timetables  Timetable[]
  assignments Assignment[]
  exams       Exam[]
  feeStructures FeeStructure[]
  feeInvoices FeeInvoice[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

/// Standard / Grade / Class (e.g., Class 10)
model Class {
  id           String       @id @default(uuid())
  schoolId     String
  name         String       // e.g. "Class 10"
  numericOrder Int          @default(0) // for sorted ordering 1, 2, 3.. 10
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections     Section[]
  classSubjects ClassSubject[]
  enrollments  Enrollment[]
  attendances  Attendance[]
  timetables   Timetable[]
  assignments  Assignment[]
  examSubjects ExamSubject[]
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// Section within a Class (e.g., Section A)
model Section {
  id          String       @id @default(uuid())
  schoolId    String
  classId     String
  name        String       // e.g. "A", "B"
  roomNumber  String?
  capacity    Int          @default(40)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  attendances Attendance[]
  timetables  Timetable[]
  assignments Assignment[]

  @@unique([classId, name])
  @@index([schoolId])
  @@index([classId])
}

/// Academic Subject (e.g., Mathematics, Physics)
model Subject {
  id           String       @id @default(uuid())
  schoolId     String
  name         String       // e.g. "Mathematics"
  code         String       // e.g. "MATH101"
  type         String       @default("CORE") // CORE | ELECTIVE | LAB
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects ClassSubject[]
  timetables   Timetable[]
  assignments  Assignment[]
  examSubjects ExamSubject[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

/// Junction mapping Classes to Subjects and assigning a primary Teacher
model ClassSubject {
  id          String   @id @default(uuid())
  schoolId    String
  classId     String
  subjectId   String
  teacherId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@index([teacherId])
}

// ==============================================================================
// PEOPLE PROFILES (Teachers, Students, Parents)
// ==============================================================================

/// Teacher Profile
model Teacher {
  id            String         @id @default(uuid())
  schoolId      String
  userId        String         @unique
  employeeId    String         // e.g. "TCH-001"
  designation   String?        // e.g. "Senior Mathematics Teacher"
  qualification String?
  gender        Gender         @default(OTHER)
  phone         String?
  address       String?
  joiningDate   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSubjects ClassSubject[]
  timetables    Timetable[]
  assignments   Assignment[]

  @@unique([schoolId, employeeId])
  @@index([schoolId])
}

/// Parent / Guardian Profile
model Parent {
  id           String    @id @default(uuid())
  schoolId     String
  userId       String    @unique
  relationship String    @default("FATHER") // FATHER | MOTHER | GUARDIAN
  occupation   String?
  phone        String
  address      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students     Student[]

  @@index([schoolId])
}

/// Student Profile
model Student {
  id               String         @id @default(uuid())
  schoolId         String
  userId           String?        @unique // Optional if younger student doesn't login yet
  parentId         String?
  admissionNo      String         // e.g. "ADM-2026-001"
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  gender           Gender         @default(OTHER)
  bloodGroup       String?
  emergencyContact String?
  address          String?
  status           UserStatus     @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent           Parent?        @relation(fields: [parentId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  attendanceRecords AttendanceRecord[]
  submissions      AssignmentSubmission[]
  examResults      ExamResult[]
  feeInvoices      FeeInvoice[]
  feePayments      FeePayment[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([parentId])
  @@index([status])
}

/// Preserves student's academic history across years, classes, and sections
model Enrollment {
  id             String       @id @default(uuid())
  schoolId       String
  studentId      String
  academicYearId String
  classId        String
  sectionId      String
  rollNumber     String?
  enrollmentDate DateTime     @default(now())
  status         String       @default("ACTIVE") // ACTIVE | PROMOTED | TRANSFERRED | COMPLETED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId, classId, sectionId])
  @@index([studentId])
}

// ==============================================================================
// ACADEMIC OPERATIONS (Attendance, Timetable, Assignments, Exams)
// ==============================================================================

/// Header record for attendance taken on a date for a specific class section
model Attendance {
  id             String             @id @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  sectionId      String
  date           DateTime           @db.Date
  takenById      String?            // Teacher/Admin user ID who took attendance
  remarks        String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  section        Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  records        AttendanceRecord[]

  @@unique([sectionId, date])
  @@index([schoolId, date])
  @@index([classId, sectionId, date])
}

/// Student specific attendance record
model AttendanceRecord {
  id           String           @id @default(uuid())
  attendanceId String
  studentId    String
  status       AttendanceStatus @default(PRESENT)
  reason       String?
  createdAt    DateTime         @default(now())

  attendance   Attendance       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, studentId])
  @@index([studentId, status])
}

/// Timetable schedule entry
model Timetable {
  id             String       @id @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  sectionId      String
  subjectId      String
  teacherId      String?
  dayOfWeek      DayOfWeek
  periodNumber   Int
  startTime      String       // e.g. "09:00"
  endTime        String       // e.g. "09:45"
  roomNumber     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([schoolId, classId, sectionId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
}

/// Homework / Assignment
model Assignment {
  id             String                 @id @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  sectionId      String
  subjectId      String
  teacherId      String
  title          String
  description    String
  dueDate        DateTime
  maxMarks       Decimal                @default(100.0) @db.Decimal(5, 2)
  attachmentUrl  String?
  status         String                 @default("PUBLISHED") // DRAFT | PUBLISHED | CLOSED
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  section        Section                @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject        Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions    AssignmentSubmission[]

  @@index([schoolId, classId, sectionId])
  @@index([teacherId])
}

/// Student Submission for an assignment
model AssignmentSubmission {
  id            String     @id @default(uuid())
  assignmentId  String
  studentId     String
  submittedAt   DateTime   @default(now())
  content       String?
  attachmentUrl String?
  marksObtained Decimal?   @db.Decimal(5, 2)
  feedback      String?
  status        String     @default("SUBMITTED") // SUBMITTED | GRADED | LATE
  gradedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

/// Examination Header
model Exam {
  id             String        @id @default(uuid())
  schoolId       String
  academicYearId String
  name           String        // e.g. "Mid-Term Examination 2026"
  term           String?       // e.g. "Term 1"
  startDate      DateTime
  endDate        DateTime
  status         ExamStatus    @default(UPCOMING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subjects       ExamSubject[]

  @@index([schoolId, academicYearId])
}

/// Subject Schedule under an Exam
model ExamSubject {
  id         String       @id @default(uuid())
  examId     String
  classId    String
  subjectId  String
  examDate   DateTime
  startTime  String       // "10:00"
  endTime    String       // "13:00"
  maxMarks   Decimal      @default(100.0) @db.Decimal(5, 2)
  passMarks  Decimal      @default(33.0) @db.Decimal(5, 2)
  roomNumber String?
  createdAt  DateTime     @default(now())

  exam       Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  class      Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject    Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  results    ExamResult[]

  @@unique([examId, classId, subjectId])
  @@index([examId])
}

/// Marks and Grades scored by a student
model ExamResult {
  id            String      @id @default(uuid())
  examSubjectId String
  studentId     String
  marksObtained Decimal     @db.Decimal(5, 2)
  grade         String?     // e.g. "A+", "B"
  remarks       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, studentId])
  @@index([studentId])
}

// ==============================================================================
// SCHOOL FINANCE (Fee Structure, Invoices, Payments)
// ==============================================================================

/// School fee structure definition for a class & academic year
model FeeStructure {
  id             String        @id @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  name           String        // e.g. "Annual Tuition Fee"
  totalAmount    Decimal       @db.Decimal(10, 2)
  dueDate        DateTime?
  frequency      String        @default("ONE_TIME") // ONE_TIME | MONTHLY | QUARTERLY | ANNUALLY
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  items          FeeItem[]
  invoices       FeeInvoice[]

  @@index([schoolId, academicYearId, classId])
}

/// Itemized breakdown within a fee structure
model FeeItem {
  id             String       @id @default(uuid())
  feeStructureId String
  name           String       // e.g. "Tuition", "Library", "Computer Lab"
  amount         Decimal      @db.Decimal(10, 2)

  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
}

/// Student Fee Invoice
model FeeInvoice {
  id             String        @id @default(uuid())
  schoolId       String
  academicYearId String
  studentId      String
  feeStructureId String?
  invoiceNumber  String        @unique // e.g. "INV-2026-0001"
  totalAmount    Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.0) @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0.0) @db.Decimal(10, 2)
  balanceAmount  Decimal       @db.Decimal(10, 2)
  dueDate        DateTime
  status         InvoiceStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  payments       FeePayment[]

  @@index([schoolId, status])
  @@index([studentId])
}

/// Payment Transaction Record against an invoice
model FeePayment {
  id             String        @id @default(uuid())
  schoolId       String
  feeInvoiceId   String
  studentId      String
  receiptNumber  String        @unique // e.g. "REC-2026-0001"
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(CASH)
  transactionRef String?       // e.g. UPI ref or Cheque number
  remarks        String?
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())

  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeInvoice     FeeInvoice    @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, paidAt])
  @@index([feeInvoiceId])
  @@index([studentId])
}

// ==============================================================================
// COMMUNICATIONS & DOCUMENTS
// ==============================================================================

/// Announcements / Notices published to school community
model Announcement {
  id             String       @id @default(uuid())
  schoolId       String
  authorId       String
  title          String
  content        String
  targetAudience AudienceType @default(ALL)
  targetClassId  String?
  priority       String       @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  isPublished    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([schoolId, isPublished, createdAt])
}

/// In-App Notifications
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO | WARNING | SUCCESS | ALERT
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

/// Document Metadata for uploaded files (certificates, ID cards, forms)
model Document {
  id          String   @id @default(uuid())
  schoolId    String
  entityType  String   // "STUDENT" | "TEACHER" | "SCHOOL" | "ASSIGNMENT"
  entityId    String   // ID of student, teacher, etc.
  title       String
  fileName    String
  fileUrl     String
  mimeType    String?
  fileSize    Int?     // bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, entityType, entityId])
}
