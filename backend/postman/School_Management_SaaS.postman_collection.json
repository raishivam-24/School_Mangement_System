{
  "info": {
    "_postman_id": "school-management-saas-api-v1",
    "name": "School Management SaaS API",
    "description": "Comprehensive Postman Collection for Multi-Tenant School Management SaaS Backend.\nSupports HttpOnly Cookies & Bearer Tokens, Role-Based Access, and Tenant Scoping.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication & Onboarding",
      "item": [
        {
          "name": "Get Subscription Plans (Landing Page)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/subscriptions/plans",
              "host": ["{{baseUrl}}"],
              "path": ["subscriptions", "plans"]
            }
          }
        },
        {
          "name": "Register School (Self-Service Landing Page)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.environment.set('accessToken', jsonData.data.accessToken);",
                  "    if (jsonData.data.school) {",
                  "        pm.environment.set('schoolId', jsonData.data.school.id);",
                  "    }",
                  "    console.log('Self-registered School Admin token saved!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schoolName\": \"St. Xavier High School\",\n  \"schoolCode\": \"STX-DELHI\",\n  \"schoolEmail\": \"principal@stxavier.edu\",\n  \"schoolPhone\": \"+91 98111 22334\",\n  \"schoolAddress\": \"Civil Lines, Delhi\",\n  \"plan\": \"PRO\",\n  \"billingCycle\": \"ANNUALLY\",\n  \"adminName\": \"Father Thomas\",\n  \"adminEmail\": \"admin@stxavier.edu\",\n  \"adminPassword\": \"Admin@Secure123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register-school",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register-school"]
            }
          }
        },
